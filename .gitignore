# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#mcp
.context
.vscode
.vscode/mcp.json
*.mcp.json
.mcp.json

#local claude settings
.claude/settings.local.json
.claude/worktrees/

# screenshot infra — storage states contain real session tokens, never commit
tests/screenshots/states/*.json
tests/screenshots/output/
# transient per-agent routes files (only routes.example.json is committed)
tests/screenshots/routes-*.json
# user-shared screenshots dropped into repo root
/image*.png
/screenshot*.png
/Screenshot*.png

# transient logs from `npm run test:* > tmp/...`
/tmp/